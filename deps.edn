{:paths   ["src" "resources"]

 :deps    {org.clojure/clojure                 {:mvn/version "1.12.5"}
           org.clojure/data.json               {:mvn/version "2.5.0"}

           ;; Postgres & db utils
           com.github.seancorfield/next.jdbc   {:mvn/version "1.3.939"}
           com.zaxxer/HikariCP                 {:mvn/version "5.1.0"}
           migratus/migratus                   {:mvn/version "1.5.5"}
           org.postgresql/postgresql           {:mvn/version "42.7.3"}

           ;; Web server
           ring/ring-core                      {:mvn/version "1.13.0"}
           ring/ring-json                      {:mvn/version "0.5.1"}
           ring-cors/ring-cors                 {:mvn/version "0.1.13"}
           info.sunng/ring-jetty9-adapter      {:mvn/version "0.36.0"}
           compojure/compojure                 {:mvn/version "1.7.1"}

           ;; Component system
           com.stuartsierra/component          {:mvn/version "1.1.0"}

           ;; Logging
           ch.qos.logback/logback-classic      {:mvn/version "1.5.12"}
           org.clojure/tools.logging           {:mvn/version "1.3.0"}
           org.apache.logging.log4j/log4j-core {:mvn/version "2.24.1"}
           org.apache.logging.log4j/log4j-api  {:mvn/version "2.24.1"}

           ;; Utilities
           buddy/buddy-core                    {:mvn/version "1.7.1"}
           com.github.rawleyfowler/sluj        {:mvn/version "1.0.2"}}

 :aliases {:run     {:main-opts ["-m" "core"]}

           :test    {:extra-paths ["test" "resources"]
                     :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                     :main-opts   ["-m" "kaocha.runner"]
                     :exec-fn     kaocha.runner/exec-fn
                     :exec-args   {}}

           :migrate {:main-opts ["-m" "core.migrations"]}}

 :kaocha  {:tests [{:id          :unit
                    :test-paths  ["test"]
                    :ns-patterns ["-test$"]}]}}
