{:paths   ["src" "resources"]
 :deps    {}
 :aliases {:test
           {:extra-paths ["test" "resources"]
            :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
            :main-opts   ["-m" "kaocha.runner"]
            :exec-fn     kaocha.runner/exec-fn
            :exec-args   {}}}

 :kaocha  {:tests [{:id          :unit
                    :test-paths  ["test"]
                    :ns-patterns ["-test$"]}]}}